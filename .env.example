# Salin ke .env.local untuk pengembangan lokal.
# Ambil dari: Supabase Dashboard -> Project Settings -> API.
# Publishable (anon) key aman dipakai di klien; JANGAN pernah pakai secret/service_role key di sini.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Tautan/kredensial lain (mis. Deploy Hook Cloudflare untuk rebuild blog)
# diatur di dalam aplikasi: /admin/settings -> Situs Publik. Bukan di sini.

# ---------------------------------------------------------------------------
# SEO / AEO / GEO (opsional, tetapi sangat disarankan untuk situs publik)
# Semua NEXT_PUBLIC_* di atas ikut di-bundle ke klien (bukan rahasia).
# ---------------------------------------------------------------------------

# URL kanonis situs. Ganti saat memakai domain kustom.
NEXT_PUBLIC_SITE_URL=https://geeco.pages.dev

# Nomor WhatsApp dalam format internasional, mis. 6281234567890.
# Dipakai untuk tautan pemesanan di halaman publik.
NEXT_PUBLIC_WHATSAPP=

# Email kontak yang tampil di halaman publik.
NEXT_PUBLIC_CONTACT_EMAIL=hello@geeco.id

# Alamat lengkap (opsional) — dipakai di schema LocalBusiness dan footer.
NEXT_PUBLIC_BUSINESS_ADDRESS=

# URL profil Instagram (opsional) untuk schema sameAs.
NEXT_PUBLIC_INSTAGRAM_URL=

# Kode verifikasi Google Search Console (opsional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
