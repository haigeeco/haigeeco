# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# kredensial lokal — JANGAN pernah di-commit/di-push
/user-and-password.md

# state lokal agen (berisi allowlist perintah + kredensial) — jangan di-commit
/.commandcode/settings.json

# catatan internal (memuat URL proyek Supabase, email admin, dsb.) — jangan di-commit
/timeline.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
